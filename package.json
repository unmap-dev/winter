{
  "name": "unmap-winter",
  "version": "0.0.10",
  "private": true,
  "description": "Winter: every ski area in Canada on 3D terrain, built with Unmap. An Unmap app and a starter you can clone.",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --port 3209",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/maplibre": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@luma.gl/core": "~9.4.0",
    "@unmap/deck": "0.30.0",
    "@unmap/maps": "0.30.0",
    "@unmap/sdk": "0.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0",
    "wrangler": "^4.128.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/winter.git"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/winter/issues"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
